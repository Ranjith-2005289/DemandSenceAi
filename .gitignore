# RAG vector store — regenerated automatically on first run (see rag_service.py)
backend/.chroma/

# Benchmark outputs (benchmarks/selection_benchmark.py, benchmarks/m5_ingest.py).
# Regenerable from the raw records, and the M5 source data is far too large to
# version. The *.raw.json files are the durable artifacts — they hold every
# per-series record, so any re-analysis (new weights, policies, metrics) runs
# from them without retraining. Back those up outside git if you want to keep
# a published result reproducible.
backend/results_*.csv
backend/results_*.json
backend/cfg_*.csv
backend/cfg_*.json
backend/con_*.csv
backend/con_*.json
backend/norm_*.csv
backend/norm_*.json
backend/diagnostic_*.csv
backend/diagnostic_*.json
backend/d_raw.*
backend/d_clipped.*
backend/d_balanced.*
backend/ex_*.csv
backend/ex_*.json
backend/get_*stats*.py
backend/data/
m5-forecasting-accuracy/

